(:author "Kaashif Hymabaccus"
 :deploy-dir "/home/kaashif/src/blog/deploy"
 :domain "https://www.kaashif.co.uk"
 :plugins ((disqus :shortname "kaashif")
           (incremental)
           (mathjax)
           (sitemap)
           (static-pages))
 :routing ((:post           "posts/~a")
           (:tag-index      "tag/~a")
           (:month-index    "date/~a")
           (:numeric-index  "~d")
           (:feed           "~a.xml")
           (:tag-feed       "tag/~a.xml"))
 :sitenav ((:url "http://www.kaashif.co.uk/" :name "Home")
           (:url "http://github.com/kaashif" :name "Code"))
 :staging-dir "/tmp/coleslaw/"
 :title "/dev/kaashif"
 :theme "hyde")
