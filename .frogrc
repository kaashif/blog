############################################################################
#
# THIS FILE IS NO LONGER USED.
# Use frog.rkt instead.
#
############################################################################
scheme/host = http://www.kaashif.co.uk
uri-prefix = /
title = kaashif's blog
author = Kaashif Hymabaccus
editor = $EDITOR
editor-command = {editor} {filename}
show-tag-counts? = true
permalink = /{year}/{month}/{day}/{title}/index.html
index-full? = false
feed-full? = true
posts-per-page = 1000
max-feed-items = 20
decorate-feed-uris? = true
feed-image-bugs? = true
auto-embed-tweets? = true
embed-tweet-parents? = true
racket-doc-link-code? = true
racket-doc-link-prose? = true
posts-index-uri = /index.html
source-dir = _src
output-dir = _out
python-executable = python
pygments-linenos? = false
pygments-cssclass = source
