name:                blog
version:             0
author:              Kaashif Hymabaccus
maintainer:          kaashif@kaashif.co.uk
build-type:          Simple
cabal-version:       >=1.10

executable blog
  main-is:             Main.hs
  build-depends:       base >=4.6 && <4.8,
                       hakyll,
                       MissingH,
                       pandoc,
                       containers,
                       pandoc-types,
                       blaze-html,
                       blaze-markup,
                       process,
                       time,
                       directory,
                       filepath,
                       data-default-class,
                       old-locale,
                       xml
  default-language:    Haskell2010
  hs-source-dirs:      src
  ghc-options:         -threaded
